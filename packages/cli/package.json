{
  "name": "deepblame",
  "version": "0.4.3",
  "description": "Know which AI agent wrote each line of your code, why, and what it cost \u2014 then undo just that agent's work. Works with Claude Code, Cursor, Codex and OpenCode, and speaks Agent Trace.",
  "license": "Apache-2.0",
  "homepage": "https://deepblame.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepblame/deepblame.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/deepblame/deepblame/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "deepblame": "dist/deepblame.mjs",
    "deepblame-capture": "dist/capture.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "blame",
    "provenance",
    "attribution",
    "agent-trace",
    "revert",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "cursor",
    "codex",
    "opencode"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@deepblame/core": "workspace:*",
    "@deepblame/protocol": "workspace:*"
  }
}
