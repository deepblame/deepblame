{
  "name": "deepblame",
  "version": "0.4.1",
  "description": "Know which AI agent wrote every line of your code, why it wrote it, and undo just that agent's work.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/deepblame/deepblame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepblame/deepblame.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/deepblame/deepblame/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "deepblame": "dist/deepblame.mjs",
    "deepblame-capture": "dist/capture.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "blame",
    "provenance",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "opencode",
    "codex",
    "cursor"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@deepblame/core": "workspace:*",
    "@deepblame/protocol": "workspace:*"
  }
}
